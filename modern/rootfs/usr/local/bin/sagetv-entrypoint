#!/usr/bin/env bash
set -euo pipefail
home="${SAGETV_HOME:-/opt/sagetv/server}"
uid="${PUID:-99}"; gid="${PGID:-100}"
enabled() { [[ "${1:-N}" =~ ^[Yy1Tt] ]]; }
mkdir -p "$home" /var/media /var/mediaext /var/tv
image_seed_dir=/usr/local/share/sagetv-options/.seed-ids
seed_state_dir=/opt/sagetv/.image-seeds
mkdir -p "$seed_state_dir"
component_changed() {
  local component="$1"
  [[ ! -s "$seed_state_dir/$component.sha256" ]] \
    || ! cmp -s "$image_seed_dir/$component.sha256" "$seed_state_dir/$component.sha256"
}
record_component() {
  local component="$1"
  install -m 0644 "$image_seed_dir/$component.sha256" "$seed_state_dir/$component.sha256"
}

# Seed Core once, and refresh it only when the Core payload fingerprint changes
# in a later Docker image. Same-image restarts preserve app-folder replacements.
core_seed=false
if [[ ! -f "$home/Sage.jar" || ! -f "$home/startsagecore" ]] || component_changed core; then
  core_seed=true
fi
if [[ "$core_seed" == true ]]; then
  if [[ ! -f "$home/Sage.jar" ]]; then
    echo "Initializing clean SageTV appdata from pinned image artifact"
    cp -a /usr/local/share/sagetv-dist/. "$home/"
  else
    if [[ -f "$home/startsagecore" && ! -f "$home/startsagecore.pre-u26-container" ]]; then
      cp -a "$home/startsagecore" "$home/startsagecore.pre-u26-container"
    fi
    # Update the versioned Core unit while retaining database/config/plugin
    # state. The separately installed FFmpeg plugin owns SageTVTranscoder and
    # its plugin runtime; the Core archive continues to own stock ffmpeg.
  dist_excludes=(
    --exclude='./Wiz.bin'
    --exclude='./Wiz.bak'
    --exclude='./SageTVPlugins.xml'
    --exclude='./filetracker.properties'
  )
  tar -C /usr/local/share/sagetv-dist "${dist_excludes[@]}" -cf - . \
    | tar -C "$home" -xf -
    echo "SageTV Core payload updated for this Docker image"
  fi
  record_component core
else
  echo "SageTV Core payload already seeded for this Docker image; appdata files preserved"
fi
test -f "$home/Sage.jar" || { echo "ERROR: Sage.jar missing"; exit 30; }
# Seed/update the rollback binary only on first deployment or a Core payload
# update. Ordinary same-image restarts never replace it.
if [[ "$core_seed" == true || ! -e "$home/ffmpeg.stock" ]] && [[ -e /usr/local/share/sagetv-dist/ffmpeg ]]; then
  cp /usr/local/share/sagetv-dist/ffmpeg "$home/ffmpeg.stock"
  chmod 0755 "$home/ffmpeg.stock"
  echo "Seeded ffmpeg.stock rollback binary"
fi
# A clean Core archive does not contain Sage.properties; Sage normally creates
# it on first launch. Container options must be recorded before that launch,
# so create the initially empty file without importing any prior installation.
if [[ ! -e "$home/Sage.properties" ]]; then
  : > "$home/Sage.properties"
  echo "Initialized clean Sage.properties"
fi
test -x "$home/startsagecore" || chmod 0755 "$home/startsagecore"
if [[ -n "${TZ:-}" && -e "/usr/share/zoneinfo/${TZ}" ]]; then ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime; fi

# Java uses its own CA store. Import only administrator-supplied certificates
# from persistent appdata so HTTPS XMLTV/logo sources behind a private proxy or
# enterprise TLS gateway can be used without disabling certificate checks.
ca_dir="${SAGETV_CA_CERTS_DIR:-/opt/sagetv/certs}"
if [[ -d "$ca_dir" ]]; then
  shopt -s nullglob
  for cert in "$ca_dir"/*.crt "$ca_dir"/*.cer "$ca_dir"/*.pem; do
    if ! keytool -printcert -file "$cert" >/dev/null 2>&1; then
      echo "WARNING: ignoring invalid CA certificate: $cert" >&2
      continue
    fi
    cert_alias="sagetv-$(sha256sum "$cert" | cut -d' ' -f1)"
    if ! keytool -list -cacerts -storepass changeit -alias "$cert_alias" >/dev/null 2>&1; then
      keytool -importcert -noprompt -trustcacerts -cacerts -storepass changeit \
        -alias "$cert_alias" -file "$cert" >/dev/null
      echo "Imported Java CA certificate: $(basename "$cert")"
    fi
  done
  shopt -u nullglob
fi
getent group "$gid" >/dev/null || groupadd -g "$gid" sagetv-runtime
usermod -o -u "$uid" sagetv 2>/dev/null || true
usermod -g "$gid" sagetv 2>/dev/null || true
/usr/local/bin/sagetv-options
if [[ "${OPT_SETPERMS:-Y}" =~ ^[Yy1Tt] ]]; then
  chown -R "$uid:$gid" /opt/sagetv
fi
# Fail here with a useful error instead of allowing SageTV to fail later while
# replacing Sage.properties. This also validates Unraid bind-mount ownership.
if ! gosu "$uid:$gid" sh -c 'probe="$1/.sagetv-write-test"; : > "$probe" && rm -f "$probe"' sh "$home"; then
  echo "ERROR: SageTV appdata is not writable by PUID=$uid PGID=$gid: $home" >&2
  echo "Check the Unraid path mapping and keep OPT_SETPERMS=Y for initial setup." >&2
  exit 31
fi
export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
export JAVAMEM="-Xmx${JAVA_MEM_MB:-2048}m"
export JAVAOPTS="${JAVAOPTS:-} -XX:ErrorFile=${home}/hs_err_pid%p.log -XX:+CreateCoredumpOnCrash"
export PIDFILE="${PIDFILE:-/tmp/sagetv.pid}"
export LD_LIBRARY_PATH="$home${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
echo "SageTV Ubuntu 26 Java 11; FFmpeg plugin runtime=external; HARDWARE_DECODE=${HARDWARE_DECODE:-true}"
/usr/local/bin/gpu-check || true
cd "$home"
exec /usr/local/bin/sagetv-supervisor
